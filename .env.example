PORT=5055
# Upload remapping uses MongoDB transactions, so this must be a replica set or mongos.
MONGODB_URI=mongodb://localhost:27017/your-guava?replicaSet=rs0
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional per-feature override; allowed ids are the keys of MODELS in src/config/ai.js.
AI_MODEL_CHAT=
AI_MODEL_INSIGHTS=
AI_MODEL_COLUMN_MAPPING=
AI_MODEL_MENU_REVIEW=
# Paid-AI safety budgets are rolling 24-hour Guava Credit limits.
AI_USER_DAILY_CREDIT_LIMIT=500
AI_ORG_DAILY_CREDIT_LIMIT=2000
AI_USER_CONCURRENCY_LIMIT=2
AI_ORG_CONCURRENCY_LIMIT=8
WEATHER_API_KEY=your_weatherapi_key_here
WEATHER_API_URL=https://api.weatherapi.com/v1
# Legacy Yoco OAuth/webhook integration is disabled for MVP. Production startup
# refuses YOCO_INTEGRATION_ENABLED=true; CSV upload presets still work.
YOCO_INTEGRATION_ENABLED=false
# YOCO_CLIENT_ID=
# YOCO_CLIENT_SECRET=
# YOCO_REDIRECT_URI=http://localhost:5175/connect
# YOCO_API_URL=https://api.yoco.com
# YOCO_IAM_URL=https://iam.yoco.com
# YOCO_WEBHOOK_SECRET=
# Optional load-shedding signal. Empty means unavailable.
ESKOMSEPUSH_API_KEY=
# Independent 32-byte key (64 hex chars or base64) for encrypting stored OAuth
# tokens. This is mandatory in production and must differ from JWT_SECRET.
TOKEN_ENCRYPTION_KEY=
CLIENT_URL=http://localhost:5175
# How many reverse proxies sit in front of the API (0-5). Railway: 1. Local without a proxy: 0 or unset (default 1).
TRUST_PROXY_HOPS=1
NODE_ENV=development
TZ=Africa/Johannesburg
REQUEST_LOGS_ENABLED=true
WORKFORCE_ENABLED=false
# Operations. Production refuses malformed or out-of-range numeric settings.
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
INDEX_INIT_TIMEOUT_MS=90000
MIGRATION_STARTUP_TIMEOUT_MS=60000
ANALYTICS_MAX_RANGE_DAYS=400
ANALYTICS_QUERY_MAX_TIME_MS=20000
COMBOS_MAX_BASKETS=20000
UPLOAD_READMIT_SYNC_MAX_UPLOADS=8
UPLOAD_READMIT_SYNC_MAX_ROWS=50000
UPLOAD_FAILED_RETENTION_MS=604800000
UPLOAD_MAINTENANCE_MAX_ATTEMPTS=5
UPLOAD_MAINTENANCE_RETRY_MS=300000
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
USAGE_RECONCILIATION_INTERVAL_MS=60000
BILLING_REMINDER_INTERVAL_MS=3600000
BILLING_GRACE_DAYS=3
AI_STREAM_IDLE_TIMEOUT_MS=20000
AI_STREAM_MAX_DURATION_MS=120000
AI_INSIGHT_LEASE_MS=60000
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_MAX_RETRIES=1
HISTORY_BACKFILL_CREDITS_PER_DAY=1
# Manual Yoco sync gets an overall budget independent of per-call deadlines.
YOCO_SYNC_TOTAL_MS=120000
# Test-suite switches (tests/env.js sets them). Leave unset outside tests: unset is the production behaviour.
# Production refuses RATE_LIMITS_ENABLED=false and BACKGROUND_JOBS_INLINE=true; staging and production refuse
# ORIGIN_CHECKS_ENABLED=false.
# API_CACHE_ENABLED=true
# RATE_LIMITS_ENABLED=true
# BACKGROUND_JOBS_INLINE=false
# ORIGIN_CHECKS_ENABLED=true

# Billing. Mock checkout grants plans and credit packs without taking money,
# so it needs BOTH an explicit opt-in below AND a non-production NODE_ENV.
# Setting the flag in production does not open it. It used to be gated on
# NODE_ENV alone, which meant a staging deploy that named no payment provider
# handed out upgrades for free -- as did any box where NODE_ENV was unset.
# Leave it false everywhere real money is expected.
#
# Paystack is the provider the product runs on. It settles through an outbound
# verify call rather than an inbound webhook, so it needs no tunnel locally --
# API_PUBLIC_URL may stay on localhost in development because the redirect is
# performed by the customer's own browser.
#   PAYMENT_PROVIDER=paystack
#   PAYSTACK_SECRET_KEY=sk_test_...   (sk_live_... is required in production)
# Optional: PAYSTACK_CURRENCY (default ZAR), PAYSTACK_API_URL
#
# The webhook at /api/account/payments/paystack/webhook is optional -- it only
# covers the customer closing the tab before the redirect -- and does need a
# public URL. OneGate is kept behind the same seam but is dormant.
BILLING_MOCK_ENABLED=false
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=ZAR

ONEGATE_API_URL=https://payments.onegate.co.za
ONEGATE_ORGANISATION_ID=
ONEGATE_API_SALT=
API_PUBLIC_URL=

# Transactional email (Resend)
RESEND_API_KEY=
# A sender on a domain verified in Resend. Production refuses an empty or placeholder sender.
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
# Development only: print verification, reset and invite links in the console email box. Never set on a hosted deploy.
EMAIL_CONSOLE_LINKS=true
# Optional: 32+ characters. Callers that send it as X-Readiness-Token get the detailed /api/ready and /api/health.
READINESS_TOKEN=
# Manager invitation links are single-use and expire after this bounded window (1-168 hours).
TEAM_INVITE_TTL_HOURS=48

# Cloudflare R2 (file storage for upload history)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=10000
UPLOAD_MAX_COLUMNS=100
UPLOAD_MAX_CELL_CHARS=10000
UPLOAD_MAX_ITEMS_PER_TRANSACTION=100
UPLOAD_MAX_ITEM_QUANTITY=10000
UPLOAD_MAX_ABSOLUTE_AMOUNT=10000000
UPLOAD_MAX_ITEM_NAME_CHARS=200
UPLOAD_MAX_IDENTIFIER_CHARS=200
UPLOAD_MAX_DATE_RANGE_DAYS=1830
UPLOAD_MAX_FUTURE_DAYS=366
UPLOAD_MIN_YEAR=2000
UPLOAD_MAX_ROW_BYTES=131072
XLSX_MAX_PART_BYTES=4194304
EVENT_LOOP_LOG_INTERVAL_MS=60000
XLSX_MAX_ENTRIES=1000
XLSX_MAX_TOTAL_UNCOMPRESSED_BYTES=52428800
XLSX_MAX_ENTRY_UNCOMPRESSED_BYTES=20971520
XLSX_MAX_COMPRESSION_RATIO=200
UPLOAD_PARSING_LEASE_MS=900000
UPLOAD_PENDING_RETENTION_MS=86400000
UPLOAD_CLEANUP_INTERVAL_MS=3600000

# Optional local-only seed helpers. src/seed.js accepts CSV/XLSX imports;
# src/seed-bulk.js is XLSX-only. Seed scripts refuse production and non-local
# databases unless SEED_FORCE=true is explicitly set.
# SEED_IMPORT_FILE=./tests/fixtures/test-transactions.csv
# SEED_USER_NAME=Demo Owner
# SEED_USER_EMAIL=demo@yourguava.local
# SEED_USER_PASSWORD=password123
# SEED_ORG_NAME=Demo Coffee Group
# SEED_CAFE_NAME=Demo Cafe
# SEED_CAFE_CITY=Cape Town
# SEED_CAFE_ADDRESS=Demo address

# Accounting integrations stay disabled for MVP. Production startup refuses true
# until provider posting is implemented end-to-end.
ACCOUNTING_INTEGRATIONS_ENABLED=false

# Xero: https://developer.xero.com/myapps
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5175/integrations/xero/callback

# QuickBooks (Intuit Developer): https://developer.intuit.com/app/developer/myapps
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:5175/integrations/quickbooks/callback
QUICKBOOKS_ENV=sandbox

# Sage Accounting: https://developer.sage.com/accounting/
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=http://localhost:5175/integrations/sage/callback

# Outbound HTTP deadlines (src/utils/http.js). Defaults apply when unset.
# Connect / socket inactivity: 20-30000 ms, capped by each service's total.
# OUTBOUND_CONNECT_TIMEOUT_MS=5000
# Total wall-clock deadline per call: 50-120000 ms.
# OUTBOUND_RESEND_TIMEOUT_MS=10000
# OUTBOUND_R2_TIMEOUT_MS=30000
# OUTBOUND_YOCO_TIMEOUT_MS=20000
# OUTBOUND_XERO_TIMEOUT_MS=15000
# OUTBOUND_QUICKBOOKS_TIMEOUT_MS=15000
# OUTBOUND_SAGE_TIMEOUT_MS=15000
# OUTBOUND_PAYSTACK_TIMEOUT_MS=20000
# OUTBOUND_ONEGATE_TIMEOUT_MS=20000
# OUTBOUND_WEATHER_TIMEOUT_MS=8000
# OUTBOUND_ESKOMSEPUSH_TIMEOUT_MS=5000
# Yoco: 1-2000 pages of 50 orders; a capped sync reports truncated.
# YOCO_SYNC_MAX_PAGES=200

# Signs local-storage downloads when R2 is not configured. Independent from session and token keys.
# 32+ random characters; generate locally: node -e "process.stdout.write(require('crypto').randomBytes(36).toString('base64url'))"
DOWNLOAD_SIGNING_SECRET=

# Rotation: set the old key here and the new key in TOKEN_ENCRYPTION_KEY, deploy,
# run node src/migrations/reencrypt-secrets.js --apply, confirm a zero-upgrade dry run, then remove this variable.
# Wait to run --apply until rollback below BE-09-T03 is ruled out. Older code cannot read v2 envelopes;
# rolling back requires reconnecting the integrations (ISSUES #78 / GATE-03).
# Development only: a JWT-fallback key of 64 hex or 43-44 base64 characters cannot be used as the
# previous key: JWT fallback is scrypted, while the explicit previous key is interpreted as raw bytes.
# Reconnect those development integrations when switching to an explicit encryption key.
# Interim pre-release v2 envelopes without authenticated key ids must be recreated; v1 remains readable.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=
